QFrame[class="MetadataBrowser"], QFrame[class="MetadataEditor"] {
    background: transparent;
}

QFrame[class="MetadataPreview"] {
    background: #fff8fb;
    border: 1px solid #efcbd9;
    border-radius: 14px;
}

QLabel[class="ImagePreview"] {
    background: #fffdfd;
    border: 1px solid #efcbd9;
    border-radius: 12px;
    color: #a87b8c;
    padding: 12px;
}

QLabel[class="SectionTitle"] {
    color: #4b3340;
    font-size: 16px;
    font-weight: 700;
}

QLabel[class="MutedLabel"] {
    color: #a17f8e;
}

QFrame[class="MetadataBrowser"] QLineEdit,
QFrame[class="MetadataBrowser"] QComboBox {
    min-height: 36px;
}

QListWidget[class="FileList"]::item {
    min-height: 62px;
    margin: 2px 0;
    padding: 5px;
    border-radius: 9px;
}

QListWidget[class="FileList"]::item:selected {
    background: rgba(224, 139, 170, 0.24);
    border: 1px solid rgba(215, 117, 153, 0.6);
}
