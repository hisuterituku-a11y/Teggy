/* Teggy Premium Foundation — cards
   Базовые карточки, заголовки, секции и визуальные состояния. */

Card,
PremiumCard,
QFrame[card="true"],
QWidget[card="true"] {
    background-color: @colors_card;
    border: 1px solid @colors_border;
    border-radius: @radius_lg px;
}

Card:hover,
PremiumCard:hover,
QFrame[card="true"]:hover,
QWidget[card="true"]:hover {
    border-color: @colors_border_hover;
}

Card[compact="true"],
PremiumCard[compact="true"],
QFrame[card="true"][compact="true"] {
    border-radius: @radius_md px;
}

PremiumCard,
Card[variant="premium"],
QFrame[card="true"][variant="premium"] {
    background-color: @colors_surface;
    border: 1px solid @colors_border_hover;
}

Card[variant="accent"],
PremiumCard[variant="accent"],
QFrame[card="true"][variant="accent"] {
    background-color: @colors_accent_soft;
    border: 1px solid @colors_accent;
}

Card[variant="success"],
PremiumCard[variant="success"],
QFrame[card="true"][variant="success"] {
    background-color: @colors_success_soft;
    border: 1px solid @colors_success;
}

Card[variant="warning"],
PremiumCard[variant="warning"],
QFrame[card="true"][variant="warning"] {
    background-color: @colors_warning_soft;
    border: 1px solid @colors_warning;
}

Card[variant="danger"],
PremiumCard[variant="danger"],
QFrame[card="true"][variant="danger"] {
    background-color: @colors_error_soft;
    border: 1px solid @colors_error;
}

Card[selected="true"],
PremiumCard[selected="true"],
QFrame[card="true"][selected="true"] {
    border: @size_focus_border px solid @colors_accent;
}

CardHeader,
QWidget[cardHeader="true"] {
    min-height: @size_card_header px;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @colors_border;
}

CardHeader QLabel,
QWidget[cardHeader="true"] QLabel {
    color: @colors_text;
    font-family: "@typography_family";
    font-size: @typography_size_large px;
    font-weight: @typography_weight_semibold;
}

CardBody,
QWidget[cardBody="true"] {
    background-color: transparent;
    border: none;
}

/* Универсальные секции внутри страниц */
Section,
QFrame[section="true"],
QWidget[section="true"] {
    background-color: transparent;
    border: none;
}

Section[filled="true"],
QFrame[section="true"][filled="true"],
QWidget[section="true"][filled="true"] {
    background-color: @colors_surface;
    border: 1px solid @colors_border;
    border-radius: @radius_md px;
}

/* Заголовки и вспомогательный текст карточек */
QLabel[role="cardTitle"],
QLabel[role="sectionTitle"] {
    color: @colors_text;
    font-family: "@typography_family";
    font-size: @typography_size_large px;
    font-weight: @typography_weight_semibold;
}

QLabel[role="cardSubtitle"],
QLabel[role="sectionSubtitle"],
QLabel[role="muted"] {
    color: @colors_text_secondary;
    font-family: "@typography_family";
    font-size: @typography_size_small px;
}

/* Разделители */
Divider,
QFrame[divider="true"],
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    background-color: @colors_border;
    border: none;
    max-height: @size_divider px;
    min-height: @size_divider px;
}
