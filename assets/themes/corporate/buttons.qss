/* Teggy Premium Foundation — buttons
   Загружается автоматически после style.qss. */

QPushButton,
QToolButton {
    min-height: @size_button px;
    padding: 0 @spacing_md px;
    background-color: @colors_surface;
    color: @colors_text;
    border: 1px solid @colors_border;
    border-radius: @radius_pill px;
    font-family: "@typography_family";
    font-size: @typography_size px;
    font-weight: @typography_weight_semibold;
    spacing: @spacing_sm px;
    outline: none;
}

QPushButton:hover,
QToolButton:hover {
    background-color: @colors_surface_hover;
    border-color: @colors_border_hover;
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:checked,
QToolButton:checked {
    background-color: @colors_surface_pressed;
    border-color: @colors_accent;
}

QPushButton:focus,
QToolButton:focus {
    border: @size_focus_border px solid @colors_focus;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: @colors_surface_pressed;
    color: @colors_text_disabled;
    border-color: @colors_border;
}

/* Primary */
QPushButton[variant="primary"],
QPushButton[class="PrimaryButton"] {
    background-color: @colors_accent;
    color: @colors_text;
    border: 1px solid @colors_accent;
    font-weight: @typography_weight_bold;
}

QPushButton[variant="primary"]:hover,
QPushButton[class="PrimaryButton"]:hover {
    background-color: @colors_accent_hover;
    border-color: @colors_accent_hover;
}

QPushButton[variant="primary"]:pressed,
QPushButton[class="PrimaryButton"]:pressed {
    background-color: @colors_accent_pressed;
    border-color: @colors_accent_pressed;
}

QPushButton[variant="primary"]:focus,
QPushButton[class="PrimaryButton"]:focus {
    border: @size_focus_border px solid @colors_text;
}

QPushButton[variant="primary"]:disabled,
QPushButton[class="PrimaryButton"]:disabled,
QPushButton[variant="primary"][busy="true"],
QPushButton[class="PrimaryButton"][busy="true"] {
    background-color: @colors_surface;
    color: @colors_text_disabled;
    border-color: @colors_border;
}

/* Secondary */
QPushButton[variant="secondary"],
QPushButton[class="SecondaryButton"] {
    background-color: @colors_accent_soft;
    color: @colors_accent_hover;
    border: 1px solid @colors_accent;
}

QPushButton[variant="secondary"]:hover,
QPushButton[class="SecondaryButton"]:hover {
    background-color: @colors_accent;
    color: @colors_text;
    border-color: @colors_accent_hover;
}

QPushButton[variant="secondary"]:pressed,
QPushButton[class="SecondaryButton"]:pressed {
    background-color: @colors_accent_pressed;
    color: @colors_text;
    border-color: @colors_accent_pressed;
}

QPushButton[variant="secondary"]:disabled,
QPushButton[class="SecondaryButton"]:disabled {
    background-color: transparent;
    color: @colors_text_disabled;
    border-color: @colors_border;
}

/* Success */
QPushButton[variant="success"],
QPushButton[class="SuccessButton"] {
    background-color: @colors_success;
    color: @colors_text;
    border: 1px solid @colors_success;
}

QPushButton[variant="success"]:hover,
QPushButton[class="SuccessButton"]:hover {
    background-color: @colors_success_hover;
    border-color: @colors_success_hover;
}

QPushButton[variant="success"]:pressed,
QPushButton[class="SuccessButton"]:pressed {
    background-color: @colors_success_pressed;
    border-color: @colors_success_pressed;
}

/* Danger */
QPushButton[variant="danger"],
QPushButton[class="DangerButton"] {
    background-color: @colors_error_soft;
    color: @colors_error_hover;
    border: 1px solid @colors_error;
}

QPushButton[variant="danger"]:hover,
QPushButton[class="DangerButton"]:hover {
    background-color: @colors_error;
    color: @colors_text;
    border-color: @colors_error_hover;
}

QPushButton[variant="danger"]:pressed,
QPushButton[class="DangerButton"]:pressed {
    background-color: @colors_error_pressed;
    color: @colors_text;
    border-color: @colors_error_pressed;
}

/* Icon-only */
QPushButton[variant="icon"],
QPushButton[class="IconButton"],
QToolButton[variant="icon"] {
    min-width: @size_icon_button px;
    max-width: @size_icon_button px;
    min-height: @size_icon_button px;
    max-height: @size_icon_button px;
    padding: 0;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius_pill px;
}

QPushButton[variant="icon"]:hover,
QPushButton[class="IconButton"]:hover,
QToolButton[variant="icon"]:hover {
    background-color: @colors_hover;
    border-color: @colors_border;
}

QPushButton[variant="icon"]:pressed,
QPushButton[class="IconButton"]:pressed,
QToolButton[variant="icon"]:pressed {
    background-color: @colors_surface_pressed;
    border-color: @colors_accent;
}

QPushButton[variant="icon"]:disabled,
QPushButton[class="IconButton"]:disabled,
QToolButton[variant="icon"]:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* Optional compact mode: widget.setProperty("compact", True) */
QPushButton[compact="true"],
QToolButton[compact="true"] {
    min-height: @size_button_compact px;
    padding: 0 @spacing_sm px;
    border-radius: @radius_md px;
    font-size: @typography_size_small px;
}

/* Flat mode for quiet toolbar actions */
QPushButton[flat="true"],
QToolButton[flat="true"] {
    background-color: transparent;
    border-color: transparent;
}

QPushButton[flat="true"]:hover,
QToolButton[flat="true"]:hover {
    background-color: @colors_hover;
    border-color: transparent;
}
