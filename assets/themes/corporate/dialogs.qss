/* Teggy Premium Foundation — dialogs, menus and tooltips */

QDialog,
QMessageBox,
QFileDialog,
QInputDialog {
    background-color: @colors_bg;
    color: @colors_text;
    font-family: "@typography_family";
    font-size: @typography_size px;
}

QDialog[panel="true"],
QFrame[dialogCard="true"],
QWidget[dialogCard="true"] {
    min-width: @size_dialog_min_width px;
    background-color: @colors_card;
    border: 1px solid @colors_border;
    border-radius: @radius_lg px;
}

QMessageBox QLabel,
QDialog QLabel {
    color: @colors_text;
    background: transparent;
}

QDialog QLabel[role="subtitle"],
QMessageBox QLabel[role="subtitle"] {
    color: @colors_text_secondary;
}

QMenu {
    padding: @spacing_xs px;
    background-color: @colors_card;
    color: @colors_text;
    border: 1px solid @colors_border_hover;
    border-radius: @radius_sm px;
    font-family: "@typography_family";
    font-size: @typography_size px;
}

QMenu::item {
    min-height: @size_button_compact px;
    padding: 0 @spacing_md px;
    border-radius: @radius_xs px;
}

QMenu::item:selected {
    background-color: @colors_hover;
    color: @colors_text;
}

QMenu::item:disabled {
    color: @colors_text_disabled;
}

QMenu::separator {
    height: 1px;
    margin: @spacing_xs px @spacing_sm px;
    background-color: @colors_border;
}

QToolTip {
    padding: @spacing_sm px @spacing_md px;
    background-color: @colors_surface;
    color: @colors_text;
    border: 1px solid @colors_border_hover;
    border-radius: @radius_sm px;
    font-family: "@typography_family";
    font-size: @typography_size_small px;
}

QProgressBar {
    min-height: 10px;
    max-height: 10px;
    background-color: @colors_surface_pressed;
    border: none;
    border-radius: 5px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: @colors_accent;
    border-radius: 5px;
}