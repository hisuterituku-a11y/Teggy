/* Teggy Premium Foundation — sidebar navigation */

Sidebar,
QFrame[sidebar="true"],
QWidget[sidebar="true"] {
    min-width: @size_sidebar px;
    max-width: @size_sidebar px;
    background-color: @colors_card;
    border: none;
    border-right: 1px solid @colors_border;
}

Sidebar[collapsed="true"],
QFrame[sidebar="true"][collapsed="true"],
QWidget[sidebar="true"][collapsed="true"] {
    min-width: @size_toolbar px;
    max-width: @size_toolbar px;
}

Sidebar QLabel[role="brand"],
QWidget[sidebar="true"] QLabel[role="brand"] {
    color: @colors_text;
    font-family: "@typography_family";
    font-size: @typography_size_large px;
    font-weight: @typography_weight_bold;
}

Sidebar QLabel[role="sectionLabel"],
QWidget[sidebar="true"] QLabel[role="sectionLabel"] {
    color: @colors_text_secondary;
    font-family: "@typography_family";
    font-size: @typography_size_small px;
    font-weight: @typography_weight_semibold;
}

Sidebar QPushButton,
Sidebar QToolButton,
QWidget[sidebar="true"] QPushButton,
QWidget[sidebar="true"] QToolButton,
QPushButton[role="navigation"],
QToolButton[role="navigation"] {
    min-height: @size_sidebar_item px;
    max-height: @size_sidebar_item px;
    padding: 0 @spacing_md px;
    background-color: transparent;
    color: @colors_text_secondary;
    border: 1px solid transparent;
    border-radius: @radius_md px;
    text-align: left;
    font-family: "@typography_family";
    font-size: @typography_size px;
    font-weight: @typography_weight_medium;
}

Sidebar QPushButton:hover,
Sidebar QToolButton:hover,
QWidget[sidebar="true"] QPushButton:hover,
QWidget[sidebar="true"] QToolButton:hover,
QPushButton[role="navigation"]:hover,
QToolButton[role="navigation"]:hover {
    background-color: @colors_hover;
    color: @colors_text;
    border-color: @colors_border;
}

Sidebar QPushButton:checked,
Sidebar QPushButton[active="true"],
Sidebar QToolButton:checked,
Sidebar QToolButton[active="true"],
QWidget[sidebar="true"] QPushButton:checked,
QWidget[sidebar="true"] QPushButton[active="true"],
QWidget[sidebar="true"] QToolButton:checked,
QWidget[sidebar="true"] QToolButton[active="true"],
QPushButton[role="navigation"]:checked,
QPushButton[role="navigation"][active="true"],
QToolButton[role="navigation"]:checked,
QToolButton[role="navigation"][active="true"] {
    background-color: @colors_accent_soft;
    color: @colors_accent_hover;
    border-color: @colors_accent;
    font-weight: @typography_weight_semibold;
}

Sidebar QPushButton:pressed,
Sidebar QToolButton:pressed,
QWidget[sidebar="true"] QPushButton:pressed,
QWidget[sidebar="true"] QToolButton:pressed,
QPushButton[role="navigation"]:pressed,
QToolButton[role="navigation"]:pressed {
    background-color: @colors_accent_pressed;
    color: @colors_text;
    border-color: @colors_accent_pressed;
}

Sidebar QPushButton:disabled,
Sidebar QToolButton:disabled,
QWidget[sidebar="true"] QPushButton:disabled,
QWidget[sidebar="true"] QToolButton:disabled {
    background-color: transparent;
    color: @colors_text_disabled;
    border-color: transparent;
}

/* Нижняя зона аккаунта / настроек */
QWidget[role="sidebarFooter"] {
    background-color: @colors_surface_pressed;
    border: 1px solid @colors_border;
    border-radius: @radius_md px;
}

QLabel[role="sidebarHint"] {
    color: @colors_text_secondary;
    font-size: @typography_size_small px;
}
