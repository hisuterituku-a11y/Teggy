/* Teggy Premium Foundation — scrollbars */

QScrollBar:vertical {
    width: @size_scrollbar px;
    margin: 2px;
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical {
    min-height: @size_scrollbar_handle_min px;
    background-color: @colors_border_hover;
    border: 2px solid transparent;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: @colors_text_secondary;
}

QScrollBar::handle:vertical:pressed {
    background-color: @colors_accent;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: @size_scrollbar px;
    margin: 2px;
    background: transparent;
    border: none;
}

QScrollBar::handle:horizontal {
    min-width: @size_scrollbar_handle_min px;
    background-color: @colors_border_hover;
    border: 2px solid transparent;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @colors_text_secondary;
}

QScrollBar::handle:horizontal:pressed {
    background-color: @colors_accent;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
    border: none;
}