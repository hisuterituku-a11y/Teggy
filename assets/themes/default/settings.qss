/* Settings page */

QCheckBox#SettingsCheckBox::indicator {
    width: 20px;
    height: 20px;
    background: #0B1022;
    border: 1px solid #46517A;
    border-radius: 6px;
}

QCheckBox#SettingsCheckBox::indicator:hover {
    background: #171F3A;
    border-color: #A778FF;
}

QCheckBox#SettingsCheckBox::indicator:checked {
    background: #915CFF;
    border-color: #A778FF;
    image: url(assets/icons/teggy/check.svg);
}

QCheckBox#SettingsCheckBox {
    min-height: 34px;
    spacing: 10px;
    color: #F7F5FF;
    font-weight: 600;
}

QPushButton#ThemeChoiceButton {
    min-height: 72px;
    padding: 12px 16px;
    text-align: left;
    background: #11182D;
    color: #F7F5FF;
    border: 1px solid #303B68;
    border-radius: 12px;
    font-weight: 600;
}

QPushButton#ThemeChoiceButton:hover {
    background: #171F3A;
    border-color: #915CFF;
}

QPushButton#ThemeChoiceButton:checked {
    background: #39206B;
    border: 2px solid #A778FF;
    color: #FFFFFF;
}

#SettingsPage QPushButton#YandexActionButton {
    min-height: 38px;
    padding: 0 16px;
}
