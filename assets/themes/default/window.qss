/* Custom window chrome and dialogs */

#WindowShell {
    background: #070B18;
    border: 1px solid #242D50;
    border-radius: 14px;
}

#WindowBody,
#ContentShell,
#PageStack,
#PageScroll,
#PageScroll > QWidget,
#PageScroll > QWidget > QWidget {
    background: #070B18;
}

#PageScroll {
    border: none;
}

#PageScroll QScrollBar:vertical {
    background: #0B1022;
    width: 10px;
    margin: 0;
}

#PageScroll QScrollBar::handle:vertical {
    background: #39206B;
    border-radius: 5px;
    min-height: 28px;
}

#PageScroll QScrollBar::add-line:vertical,
#PageScroll QScrollBar::sub-line:vertical {
    height: 0;
}

#PageStack QLineEdit {
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
    margin: 0;
    selection-background-color: #7C4DDE;
    selection-color: #FFFFFF;
}

#PageStack QTextEdit,
#PageStack QPlainTextEdit {
    min-height: 76px;
    max-height: 76px;
    padding: 6px 10px;
    margin: 0;
    selection-background-color: #7C4DDE;
    selection-color: #FFFFFF;
}

#FileList {
    min-width: 340px;
}

#FileItem {
    min-height: 66px;
    max-height: 66px;
}

#FileName,
#FileInfo {
    min-height: 18px;
    padding: 0;
    margin: 0;
}

#ThumbnailPreviewBox,
#ThumbnailImage {
    background: #0A1020;
    border: 1px solid #29345B;
    border-radius: 10px;
    padding: 0;
}

#ThumbnailPreviewBox #ThumbnailImage {
    border: none;
}

#ThumbnailRemoveButton {
    background: #FF5F57;
    color: #6B1715;
    border: 1px solid #E0443E;
    border-radius: 12px;
    padding: 0;
    font-size: 16px;
    font-weight: 800;
}

#ThumbnailRemoveButton:hover {
    background: #FF736D;
    color: #4A0D0B;
    border-color: #FF8A85;
}

#ThumbnailRemoveButton:pressed {
    background: #E24B45;
    color: #330706;
    border-color: #C93B36;
}

#WindowTitleBar {
    background: #0B1022;
    border-bottom: 1px solid #242D50;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}

#WindowTitle {
    color: #F7F5FF;
    font-size: 13px;
    font-weight: 700;
}

#WindowControlButton,
#WindowHelpButton,
#WindowCloseButton {
    background: transparent;
    color: #B9C2E3;
    border: none;
    border-radius: 0;
    font-size: 18px;
    padding: 0;
}

#WindowControlButton:hover,
#WindowHelpButton:hover {
    background: #151D39;
    color: #FFFFFF;
}

#WindowCloseButton:hover {
    background: #D43C55;
    color: #FFFFFF;
    border-top-right-radius: 13px;
}

#AboutDialog,
#ResultDialog {
    background: #0E1428;
    border: 1px solid #303B68;
    border-radius: 14px;
}

#AboutContent,
#ResultContent {
    background: transparent;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

#AboutTitle,
#ResultTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
    padding: 2px 0 4px 0;
}

#AboutDescription,
#ResultStatLabel {
    color: #AAB2D4;
    font-size: 13px;
    padding: 2px 0;
}

#ResultStats {
    background: #11182D;
    border: 1px solid #303B68;
    border-radius: 12px;
}

#ResultStatValue {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    padding: 2px 0;
}

#AboutPrimaryButton {
    background: #7C4DDE;
    color: #FFFFFF;
    border: 1px solid #A778FF;
    border-radius: 12px;
    min-height: 38px;
    font-weight: 700;
}

#AboutPrimaryButton:hover {
    background: #915CFF;
}

#AboutSecondaryButton {
    background: #141B35;
    color: #D8DDF4;
    border: 1px solid #303B68;
    border-radius: 10px;
    min-height: 34px;
}

#AboutSecondaryButton:hover {
    background: #1A2343;
    border-color: #915CFF;
}

#ToggleCheckBox {
    spacing: 10px;
    color: #F7F5FF;
    font-weight: 600;
}

#ToggleCheckBox::indicator {
    width: 42px;
    height: 22px;
    border-radius: 11px;
    background: #202A4A;
    border: 1px solid #3A466F;
}

#ToggleCheckBox::indicator:checked {
    background: #7C4DDE;
    border-color: #A778FF;
}

QMessageBox {
    background: #0E1428;
}

QMessageBox QLabel {
    color: #F7F5FF;
}

QMessageBox QPushButton {
    min-width: 96px;
    min-height: 32px;
    background: #7C4DDE;
    color: #FFFFFF;
    border: 1px solid #A778FF;
    border-radius: 8px;
}

QMessageBox QPushButton:hover {
    background: #915CFF;
}
