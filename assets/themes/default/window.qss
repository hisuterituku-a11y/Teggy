/* Custom window chrome and dialogs */

#WindowShell {
    background: #070B18;
    border: 1px solid #242D50;
}

#WindowTitleBar {
    background: #0B1022;
    border-bottom: 1px solid #242D50;
}

#WindowTitle {
    color: #F7F5FF;
    font-size: 13px;
    font-weight: 700;
}

#WindowControlButton,
#WindowHelpButton,
#WindowCloseButton {
    background: transparent;
    color: #B9C2E3;
    border: none;
    border-radius: 0;
    font-size: 18px;
    padding: 0;
}

#WindowControlButton:hover,
#WindowHelpButton:hover {
    background: #151D39;
    color: #FFFFFF;
}

#WindowCloseButton:hover {
    background: #D43C55;
    color: #FFFFFF;
}

#AboutDialog {
    background: #0E1428;
}

#AboutMark {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #915CFF,
        stop:1 #5C2FC2
    );
    color: #FFFFFF;
    border: 1px solid #B28AFF;
    border-radius: 20px;
    font-size: 30px;
    font-weight: 800;
}

#AboutTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
}

#AboutDescription {
    color: #AAB2D4;
    font-size: 13px;
}

#AboutRepositoryButton {
    background: #7C4DDE;
    color: #FFFFFF;
    border: 1px solid #A778FF;
    border-radius: 12px;
    min-height: 38px;
    font-weight: 700;
}

#AboutRepositoryButton:hover {
    background: #915CFF;
}

#AboutButtonBox QPushButton {
    background: #141B35;
    color: #D8DDF4;
    border: 1px solid #303B68;
    border-radius: 10px;
    min-width: 96px;
    min-height: 34px;
}

#AboutButtonBox QPushButton:hover {
    background: #1A2343;
    border-color: #915CFF;
}
