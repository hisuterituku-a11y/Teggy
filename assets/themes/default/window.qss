/* Custom window chrome and dialogs */

#WindowShell {
    background: #070B18;
    border: 1px solid #242D50;
    border-radius: 14px;
}

#WindowBody,
#ContentShell,
#PageStack,
#PageScroll,
#PageScroll > QWidget,
#PageScroll > QWidget > QWidget {
    background: #070B18;
}

#PageScroll {
    border: none;
}

#PageScroll QScrollBar:vertical {
    background: #0B1022;
    width: 10px;
    margin: 0;
}

#PageScroll QScrollBar::handle:vertical {
    background: #39206B;
    border-radius: 5px;
    min-height: 28px;
}

#PageScroll QScrollBar::add-line:vertical,
#PageScroll QScrollBar::sub-line:vertical {
    height: 0;
}

#PageStack QLineEdit,
#PageStack QTextEdit,
#PageStack QPlainTextEdit {
    min-height: 38px;
}

#PageStack QTextEdit,
#PageStack QPlainTextEdit {
    min-height: 120px;
}

#FileList {
    min-width: 340px;
}

#FileItem {
    min-height: 66px;
    max-height: 66px;
}

#FileName,
#FileInfo {
    min-height: 18px;
    padding: 0;
    margin: 0;
}

#WindowTitleBar {
    background: #0B1022;
    border-bottom: 1px solid #242D50;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}

#WindowTitle {
    color: #F7F5FF;
    font-size: 13px;
    font-weight: 700;
}

#WindowControlButton,
#WindowHelpButton,
#WindowCloseButton {
    background: transparent;
    color: #B9C2E3;
    border: none;
    border-radius: 0;
    font-size: 18px;
    padding: 0;
}

#WindowControlButton:hover,
#WindowHelpButton:hover {
    background: #151D39;
    color: #FFFFFF;
}

#WindowCloseButton:hover {
    background: #D43C55;
    color: #FFFFFF;
    border-top-right-radius: 13px;
}

#AboutDialog {
    background: #0E1428;
    border: 1px solid #303B68;
    border-radius: 14px;
}

#AboutContent {
    background: transparent;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

#AboutTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
}

#AboutDescription {
    color: #AAB2D4;
    font-size: 13px;
}

#AboutPrimaryButton {
    background: #7C4DDE;
    color: #FFFFFF;
    border: 1px solid #A778FF;
    border-radius: 12px;
    min-height: 38px;
    font-weight: 700;
}

#AboutPrimaryButton:hover {
    background: #915CFF;
}

#AboutSecondaryButton {
    background: #141B35;
    color: #D8DDF4;
    border: 1px solid #303B68;
    border-radius: 10px;
    min-height: 34px;
}

#AboutSecondaryButton:hover {
    background: #1A2343;
    border-color: #915CFF;
}
