QWidget { color: #FAF3FF; }
QMainWindow, QStackedWidget, QScrollArea, #WindowShell, #WindowBody, #ContentShell, #DashboardPage { background: #120919; }
#Sidebar, #TopBar { background: #1A0D24; border-color: #3D214F; }
#PhotoPanel, #DashboardPanel, #TemplateDialog, #TemplateSidebar, #TemplateEditor { background: #21102D; border-color: #4C2A60; }
#SideButton { color: #E6CEE8; }
#SideButton:hover { background: #2A1538; }
#SideButton:checked { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #5B216F,stop:1 #3B164C); border-color: #D05CEB; }
#TopBar QLineEdit, QLineEdit, QTextEdit, QPlainTextEdit, QComboBox { background: #1B0F27; border-color: #523064; color: #FFF7FF; }
#TopBar QLineEdit:focus, QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border-color: #D05CEB; }
#PrimaryButton, #TemplateProminentButton, #DashboardActionButton { background: #B43CD0; border-color: #E27AF4; color: white; }
#PrimaryButton:hover, #TemplateProminentButton:hover, #DashboardActionButton:hover { background: #CA55E4; }
#DownloadOptionCard[selected="true"] { background: #351643; border-color: #D05CEB; }
QCheckBox#DownloadOptionCheck::indicator:checked { background: #B43CD0; border-color: #E27AF4; }
#ThemeButton, #NotifyButton, #SettingsButton { background: #251331; border-color: #523064; }
#ThemeButton:hover, #NotifyButton:hover, #SettingsButton:hover { background: #351A45; border-color: #D05CEB; }
#DashboardHero { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #351845,stop:0.55 #69257A,stop:1 #A02B7C); border-color: #D05CEB; }
#DashboardActionIcon, #DashboardVersion { color: #E27AF4; }
#DashboardStepBadge { background: #5B216F; border-color: #D05CEB; }
#DashboardTip { background: #351845; border-color: #744486; color: #F4DFFF; }
