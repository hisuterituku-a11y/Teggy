/* Frogs: deep pond green, mint surfaces and friendly rounded controls */
QWidget { color: #EAF6EE; selection-background-color: #7FC9A4; selection-color: #0B2D24; }
QMainWindow, QDialog, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget,
#WindowShell, #WindowBody, #ContentShell, #PageStack, #DashboardPage, #SettingsPage { background: #073E34; }
#Sidebar, #TopBar, #WindowTitleBar { background: #0A4A3E; border-color: #28695A; }
#PhotoPanel, #DashboardPanel, #TemplateDialog, #TemplateSidebar, #TemplateEditor,
#DownloadOptionCard, #FolderItem, #ThumbnailCard, #PremiumCard { background: #105447; border-color: #347565; }
#DashboardHero { background-color: #155C4D; background-image: url(assets/themes/frogs/pattern.svg); border: 1px solid #86C7A0; }
#DashboardActionCard, #DashboardWorkflowRow { background: #0C493D; border-color: #337665; border-radius: 16px; }
#DashboardActionCard:hover, #DashboardWorkflowRow:hover { background: #145A4B; border-color: #A9D9BC; }
#SideButton { color: #D5EADF; }
#SideButton:hover { background: #14594B; }
#SideButton:checked { background: #D9E9CF; border-color: #A9D9BC; color: #123F33; }
#Logo, #PageTitle, #SectionTitle, #CardTitle, #DashboardWelcome, #DashboardPanelTitle,
#DashboardActionTitle, #DownloadOptionTitle { color: #F3FBF5; }
#LogoSub, #CardSubtitle, #DashboardSubtitle, #DashboardPanelText, #DownloadOptionDescription { color: #B6D2C4; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QListWidget, QTreeWidget, QTableWidget { background: #0B4439; color: #F1FAF4; border: 1px solid #438071; border-radius: 12px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QListWidget:focus { border-color: #A9D9BC; }
QPushButton#PrimaryButton, QPushButton#TemplateProminentButton, QPushButton#DashboardActionButton { background: #A9D9BC; color: #10372E; border: 1px solid #D2E8D5; border-radius: 12px; font-weight: 700; }
QPushButton#PrimaryButton:hover, QPushButton#TemplateProminentButton:hover, QPushButton#DashboardActionButton:hover { background: #C2E5CC; }
#YandexActionButton, #AboutSecondaryButton, #DashboardSecondaryButton, #TemplateManagerButton { background: #185E4F; color: #F2FAF4; border: 1px solid #4D8B78; border-radius: 12px; }
#YandexActionButton:hover, #AboutSecondaryButton:hover, #DashboardSecondaryButton:hover, #TemplateManagerButton:hover { border-color: #BCE2C7; background: #206C5A; }
#ThemeButton, #NotifyButton, #SettingsButton { background: #14594B; border-color: #3D7C6B; border-radius: 18px; }
#ThemeButton:hover, #NotifyButton:hover, #SettingsButton:hover { background: #D9E9CF; border-color: #A9D9BC; }
#DownloadOptionCard[selected="true"] { background: #D9E9CF; border-color: #A9D9BC; }
#DownloadOptionCard[selected="true"] #DownloadOptionTitle { color: #123F33; }
#DownloadOptionCard[selected="true"] #DownloadOptionDescription { color: #476B5C; }
QCheckBox#DownloadOptionCheck::indicator, QRadioButton#DownloadOptionCheck::indicator, QCheckBox#SettingsCheckBox::indicator { background: #0A4136; border: 1px solid #6CA28F; border-radius: 6px; }
QCheckBox#DownloadOptionCheck::indicator:checked, QRadioButton#DownloadOptionCheck::indicator:checked, QCheckBox#SettingsCheckBox::indicator:checked { background: #A9D9BC; border-color: #D2E8D5; }
#DashboardActionIcon, #DashboardVersion { color: #CBE6CF; }
#DashboardStepBadge { background: #D9E9CF; color: #123F33; border-color: #A9D9BC; }
#DashboardTip { background: #D9E9CF; color: #244C3D; border-color: #A9D9BC; }
QMenu, #ThemeMenu { background: #105447; color: #F3FBF5; border: 1px solid #438071; }
QMenu::item:selected { background: #D9E9CF; color: #123F33; }
QScrollBar:vertical, QScrollBar:horizontal { background: #083D33; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #679887; border-radius: 7px; }
QProgressBar { background: #0B4439; border-color: #438071; }
QProgressBar::chunk { background: #A9D9BC; }
QMessageBox { background: #0A4A3E; }
QToolTip { background: #D9E9CF; color: #123F33; border: 1px solid #86B89D; }
