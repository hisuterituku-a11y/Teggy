/* Sakura: complete warm blush theme with decorative background. */
QWidget { color: #5D3B45; selection-background-color: #D9798D; selection-color: #FFFFFF; }
QLabel { background: transparent; color: #563640; }

QMainWindow, QDialog, QStackedWidget, QAbstractScrollArea,
QAbstractScrollArea > QWidget, QAbstractScrollArea > QWidget > QWidget,
#WindowShell, #WindowBody, #ContentShell, #PageStack, #DashboardPage,
#SettingsPage, #GalleryContent, #PageScroll, #PageScroll > QWidget > QWidget {
    background-color: #F4D9DB;
}
#PageStack, #DashboardPage, #SettingsPage, #GalleryContent,
#PageScroll > QWidget > QWidget {
    background-image: url(assets/themes/sakura/pattern.svg);
    background-repeat: repeat;
}
#Sidebar, #TopBar, #WindowTitleBar { background: #FBEDEE; border-color: #E6BFC4; }

#PhotoPanel, #DashboardPanel, #TemplateDialog, #TemplateSidebar, #TemplateEditor,
#FolderItem, #ThumbnailCard, #PremiumCard, #YandexDownloadLog,
QFrame[class="Card"] { background: #FFF8F5; border-color: #E9C9CC; }

#DashboardHero {
    background-color: #F5C9CF;
    background-image: url(assets/themes/sakura/pattern.svg);
    background-repeat: repeat;
    border: 1px solid #D98B9A;
}
#DashboardActionCard, #DashboardWorkflowRow {
    background: #FFF8F5; border-color: #E6C2C7; border-radius: 17px;
}
#DashboardActionCard:hover, #DashboardWorkflowRow:hover { background: #FFFFFF; border-color: #D9798D; }

#Logo, #PageTitle, #SectionTitle, #CardTitle, #DashboardWelcome,
#DashboardPanelTitle, #DashboardActionTitle, #DownloadOptionTitle,
#FolderText, #PremiumTitle { color: #563640; background: transparent; }
#LogoSub, #CardSubtitle, #DashboardSubtitle, #DashboardPanelText,
#DownloadOptionDescription, #PremiumText { color: #8C6971; background: transparent; }

#SideButton { color: #76545E; background: transparent; }
#SideButton:hover { background: #F7DEE1; }
#SideButton:checked { background: #F2C9CF; border-color: #D9798D; color: #6A3340; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QListWidget,
QTreeWidget, QTableWidget, #Search {
    background: #FFFDFC; color: #5D3B45; border: 1px solid #DEBFC4; border-radius: 12px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QListWidget:focus, #Search:focus { border-color: #D9798D; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled,
QComboBox:disabled { background: #F6E8E8; color: #A47D85; }

QPushButton { color: #5D3B45; background: transparent; }
QPushButton#PrimaryButton, QPushButton#TemplateProminentButton,
QPushButton#DashboardActionButton {
    background: #D9798D; color: #FFFFFF; border: 1px solid #E8A4B1;
    border-radius: 12px; font-weight: 700;
}
QPushButton#PrimaryButton:hover, QPushButton#TemplateProminentButton:hover,
QPushButton#DashboardActionButton:hover { background: #E58CA0; }

#YandexActionButton, #AboutSecondaryButton, #DashboardSecondaryButton,
#TemplateManagerButton, #SettingsPage QPushButton#YandexActionButton {
    background: #F8E7E8; color: #64434C; border: 1px solid #DDB9BF; border-radius: 12px;
}
#YandexActionButton:hover, #AboutSecondaryButton:hover, #DashboardSecondaryButton:hover,
#TemplateManagerButton:hover, #SettingsPage QPushButton#YandexActionButton:hover {
    background: #F4D9DD; border-color: #D9798D;
}

#ThemeButton, #NotifyButton, #SettingsButton {
    background: #FFF8F5; color: #CC6178; border: 1px solid #E0BEC4; border-radius: 18px;
}
#ThemeButton:hover, #NotifyButton:hover, #SettingsButton:hover {
    background: #F2C9CF; border-color: #D9798D;
}

#DownloadOptionCard {
    background: #FFF8F5; border: 1px solid #E9C9CC;
}
#DownloadOptionCard[selected="true"] {
    background: #F7DCE0; border: 1px solid #D9798D;
}

QPushButton#ThemeChoiceButton {
    min-height: 76px; padding: 12px 16px; text-align: left;
    background: #FFF8F5; color: #563640; border: 1px solid #E9C9CC;
    border-radius: 12px; font-weight: 600;
}
QPushButton#ThemeChoiceButton:hover { background: #FBE5E8; border-color: #D9798D; }
QPushButton#ThemeChoiceButton:checked {
    background: #F2C9CF; color: #6A3340; border: 2px solid #D9798D;
}

QCheckBox, QRadioButton { color: #5D3B45; background: transparent; spacing: 9px; }
QCheckBox#SettingsCheckBox { color: #5D3B45; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator,
QCheckBox#DownloadOptionCheck::indicator, QRadioButton#DownloadOptionCheck::indicator,
QCheckBox#SettingsCheckBox::indicator {
    width: 18px; height: 18px; background: #FFFDFC;
    border: 1px solid #CFAAB1; border-radius: 6px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked,
QCheckBox#DownloadOptionCheck::indicator:checked,
QRadioButton#DownloadOptionCheck::indicator:checked,
QCheckBox#SettingsCheckBox::indicator:checked {
    background: #D9798D; border-color: #E8A4B1;
    image: url(assets/icons/teggy/check.svg);
}

#DashboardActionIcon, #DashboardVersion { color: #CC6178; background: transparent; }
#DashboardStepBadge { background: #F4CCD2; color: #753A47; border-color: #D9798D; }
#DashboardTip { background: #FBE1E4; color: #724650; border-color: #E2AEB8; }

QMenu, #ThemeMenu, QComboBox QAbstractItemView {
    background: #FFF8F5; color: #5D3B45; border: 1px solid #DDB9BF;
}
QMenu::item:selected, QComboBox QAbstractItemView::item:selected {
    background: #F2C9CF; color: #6A3340;
}
QScrollBar:vertical, QScrollBar:horizontal { background: #F1D9DC; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #CF939F; border-radius: 7px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #D9798D; }
QProgressBar { background: #F4E3E4; border-color: #DDB9BF; color: #5D3B45; }
QProgressBar::chunk { background: #D9798D; }
QMessageBox { background: #FFF8F5; }
QToolTip { background: #FFF4F2; color: #5D3B45; border: 1px solid #D9798D; }
